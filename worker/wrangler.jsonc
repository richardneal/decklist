{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "decklist-import-api",
  "account_id": "f81e0f0d52bb815d2073e9e646641867",
  "main": "index.mjs",
  "compatibility_date": "2026-09-16",
  "workers_dev": false,
  "routes": [
    { "pattern": "import.decklist.app", "custom_domain": true },
    // The old host keeps answering for pages loaded before the move to decklist.app.
    { "pattern": "deck-import.nealston.com", "custom_domain": true }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://decklist.app,https://decklist.nealston.com,https://nealston.com,https://www.nealston.com,http://localhost:8000,http://127.0.0.1:8000",
    "MOXFIELD_USER_AGENT": "decklist.app (+https://decklist.app)",
    "USER_AGENT": "decklist.app (+https://decklist.app)"
  },
  "ratelimits": [{
    "name": "IMPORT_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 20, "period": 60 }
  }],
  // Each import's source, outcome and time (record() in index.mjs)
  "analytics_engine_datasets": [{ "binding": "IMPORTS", "dataset": "decklist_imports" }]
}
